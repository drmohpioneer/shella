rules_version = '2';
// Shella: group expense splitter.
// Model: trips/{t} (unguessable id) -> people/{p1..p20}, members/{uid} -> {person}, expenses/{id}.
// A name (person) is locked to one browser (anonymous uid). Only the trip maker can unlock it.
// An expense belongs to the person who PAID it. The maker can only soft-delete/restore and unlock.
// Everything closes 14 days after the trip's last activity, and 30 days after it was created at the latest. Nothing is ever hard-deleted from a client.
// Backup maker: a friend with no powers until they say the maker lost their phone; after 24h without
// the maker cancelling, they become the maker. The maker can also hand the role to any joined friend.
// The maker can delete a trip (deletedAt). Any member can bring it back within 3 days; after that it is
// closed for good and the weekly cleanup erases it. While deleted, the trip is read-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function tripPath(t) { return /databases/$(database)/documents/trips/$(t); }
    function personPath(t, p) { return /databases/$(database)/documents/trips/$(t)/people/$(p); }
    function memberPath(t, u) { return /databases/$(database)/documents/trips/$(t)/members/$(u); }
    // Readable: not expired, and not deleted more than 3 days ago.
    function alive(tripData) {
      return request.time < tripData.lastActivity + duration.value(14, 'd')
        && request.time < tripData.createdAt + duration.value(30, 'd')
        && (tripData.get('deletedAt', null) == null || request.time < tripData.deletedAt + duration.value(3, 'd'));
    }
    // Writable: alive and not deleted.
    function writable(tripData) { return alive(tripData) && tripData.get('deletedAt', null) == null; }

    function isMember(t) { return signedIn() && exists(memberPath(t, request.auth.uid)); }
    function myPerson(t) { return get(memberPath(t, request.auth.uid)).data.person; }
    function isMaker(t) { return signedIn() && get(tripPath(t)).data.maker == request.auth.uid; }
    // At most 3 unlocks per trip: each unlock bumps trip.unlocks by exactly 1 in the same batch.
    function unlockCounted(t) {
      return getAfter(tripPath(t)).data.get('unlocks', 0) == get(tripPath(t)).data.get('unlocks', 0) + 1
        && getAfter(tripPath(t)).data.get('unlocks', 0) <= 3;
    }

    function str(s, min, max) { return s is string && s.size() >= min && s.size() <= max; }
    function personId(p) { return p is string && p.matches('^p([1-9]|1[0-9]|20)$'); }
    // Either an InstaPay payment link (https://ipn.eg/...) or a handle (name@instapay), or empty.
    function validInstapay(s) {
      return s is string && (s == ''
        || s.matches('^https://ipn[.]eg/[A-Za-z0-9/_.-]{1,90}$')
        || s.matches('^[A-Za-z0-9._-]{1,40}@instapay$'));
    }
    function validAvatar(a) {
      return a is map && a.keys().hasOnly(['k', 'v']) && a.keys().hasAll(['k', 'v'])
        && a.k in ['dice', 'photo', 'face'] && str(a.v, 1, 30000)
        && (a.k == 'dice' ? a.v.matches('^[A-Za-z0-9_-]{1,32}$')
          : a.k == 'face' ? a.v.matches('^s[0-9]h[0-9]t[0-9]{1,2}b[0-9]g[0-9]m[0-9]$')
                          : a.v.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }

    match /trips/{t} {
      allow get: if signedIn() && alive(resource.data);
      allow list: if false;

      allow create: if signedIn()
        && t.matches('^[A-Za-z0-9_-]{20,40}$')
        && request.resource.data.keys().hasOnly(['name', 'currency', 'maker', 'open', 'createdAt', 'lastActivity'])
        && request.resource.data.keys().hasAll(['name', 'currency', 'maker', 'open', 'createdAt', 'lastActivity'])
        && str(request.resource.data.name, 1, 40)
        && request.resource.data.currency in ['EGP', 'USD', 'EUR', 'SAR', 'AED', 'KWD', 'QAR', 'GBP', 'TRY', 'JOD']
        && request.resource.data.maker == request.auth.uid
        && request.resource.data.open == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivity == request.time;

      allow update: if isMember(t) && (
        // Members may only bump lastActivity. The maker may also rename and open/close joining.
        (writable(resource.data)
          && request.resource.data.lastActivity == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               resource.data.maker == request.auth.uid ? ['lastActivity', 'open', 'name'] : ['lastActivity'])
          && str(request.resource.data.name, 1, 40)
          && request.resource.data.open is bool)
        ||
        // The maker counts an unlock (the unlock itself is checked on the person and member docs).
        (writable(resource.data)
          && resource.data.maker == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlocks'])
          && request.resource.data.unlocks == resource.data.get('unlocks', 0) + 1
          && request.resource.data.unlocks <= 3)
        ||
        // The maker deletes the trip (soft): stamps the time and who did it.
        (writable(resource.data)
          && resource.data.maker == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == myPerson(t))
        ||
        // Backup maker: the first friend to open the trip takes the empty backup slot (only for themself).
        (writable(resource.data)
          && resource.data.maker != request.auth.uid
          && resource.data.get('backup', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['backup'])
          && request.resource.data.backup == myPerson(t))
        ||
        // The maker picks another backup: a friend who has joined, not the maker.
        (writable(resource.data)
          && resource.data.maker == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['backup'])
          && personId(request.resource.data.backup)
          && get(personPath(t, request.resource.data.backup)).data.uid != null
          && get(personPath(t, request.resource.data.backup)).data.uid != request.auth.uid)
        ||
        // The backup says the maker lost their phone: starts a 24h countdown everyone can see.
        (writable(resource.data)
          && resource.data.maker != request.auth.uid
          && resource.data.get('backup', null) == myPerson(t)
          && resource.data.get('rescueAt', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rescueAt', 'rescueBy'])
          && request.resource.data.rescueAt == request.time
          && request.resource.data.rescueBy == myPerson(t))
        ||
        // The maker (or the backup who started it) cancels the countdown.
        (writable(resource.data)
          && resource.data.get('rescueAt', null) != null
          && (resource.data.maker == request.auth.uid || resource.data.get('rescueBy', null) == myPerson(t))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rescueAt', 'rescueBy'])
          && request.resource.data.rescueAt == null
          && request.resource.data.rescueBy == null)
        ||
        // 24h passed and nobody cancelled: the backup becomes the maker. Joining reopens so the old maker can come back.
        (writable(resource.data)
          && resource.data.get('rescueAt', null) != null
          && request.time > resource.data.rescueAt + duration.value(24, 'h')
          && resource.data.get('rescueBy', null) == myPerson(t)
          && resource.data.get('backup', null) == myPerson(t)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maker', 'backup', 'rescueAt', 'rescueBy', 'open'])
          && request.resource.data.maker == request.auth.uid
          && request.resource.data.backup == null
          && request.resource.data.rescueAt == null
          && request.resource.data.rescueBy == null
          && request.resource.data.open == true)
        ||
        // The maker hands the role to a friend who has joined; the old maker becomes the backup.
        (writable(resource.data)
          && resource.data.maker == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maker', 'backup', 'rescueAt', 'rescueBy'])
          && request.resource.data.maker is string
          && request.resource.data.maker != request.auth.uid
          && exists(memberPath(t, request.resource.data.maker))
          && request.resource.data.backup == myPerson(t)
          && request.resource.data.get('rescueAt', null) == null
          && request.resource.data.get('rescueBy', null) == null)
        ||
        // Any member brings it back within the 3 days.
        (alive(resource.data)
          && resource.data.get('deletedAt', null) != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy', 'lastActivity'])
          && request.resource.data.deletedAt == null
          && request.resource.data.deletedBy == null
          && request.resource.data.lastActivity == request.time)
      );

      allow delete: if false;

      match /people/{p} {
        // Anyone holding the link sees the names, so they can pick theirs.
        allow read: if signedIn() && alive(get(tripPath(t)).data);

        // Only the maker adds people, only while joining is open. At most 20 (ids p1..p20).
        // A new person is unclaimed, except the maker's own person, claimed in the same batch.
        allow create: if signedIn() && personId(p)
          && getAfter(tripPath(t)).data.maker == request.auth.uid
          && getAfter(tripPath(t)).data.open == true
          && writable(getAfter(tripPath(t)).data)
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'instapay', 'uid'])
          && request.resource.data.keys().hasAll(['name', 'avatar', 'instapay', 'uid'])
          && str(request.resource.data.name, 1, 24)
          && validAvatar(request.resource.data.avatar)
          && validInstapay(request.resource.data.instapay)
          && (request.resource.data.uid == null
              || (request.resource.data.uid == request.auth.uid
                  && getAfter(memberPath(t, request.auth.uid)).data.person == p));

        allow update: if signedIn() && writable(get(tripPath(t)).data) && (
          // Claim: an unclaimed name, joining open, and a matching member doc in the same batch.
          (resource.data.uid == null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
            && get(tripPath(t)).data.open == true
            && getAfter(memberPath(t, request.auth.uid)).data.person == p)
          ||
          // The person themself edits their name, avatar and InstaPay handle.
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'instapay'])
            && str(request.resource.data.name, 1, 24)
            && validAvatar(request.resource.data.avatar)
            && validInstapay(request.resource.data.instapay))
          ||
          // The maker renames or changes the face of someone who hasn't joined yet...
          (isMaker(t)
            && resource.data.uid == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar'])
            && str(request.resource.data.name, 1, 24)
            && validAvatar(request.resource.data.avatar))
          ||
          // ...or unlocks someone (uid -> null, member doc removed, unlock counted, all in the same batch).
          // A joined person's name and face are theirs: the maker can't turn their slot into someone else.
          (isMaker(t)
            && resource.data.uid != null
            && resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
            && request.resource.data.uid == null
            && !existsAfter(memberPath(t, resource.data.uid))
            && unlockCounted(t))
        );

        allow delete: if false;
      }

      match /members/{u} {
        // Only you can see your own membership.
        allow get: if signedIn() && request.auth.uid == u;
        allow list: if false;

        // Join: one name per browser; the name must be claimed by you in the same batch.
        allow create: if signedIn() && request.auth.uid == u
          && request.resource.data.keys().hasOnly(['person'])
          && personId(request.resource.data.person)
          && getAfter(personPath(t, request.resource.data.person)).data.uid == u
          && getAfter(tripPath(t)).data.open == true
          && writable(getAfter(tripPath(t)).data);

        allow update: if false;

        // Unlock by the maker (the person is released in the same batch).
        // The maker can never drop their own membership, so they can't take over someone else's name.
        allow delete: if isMaker(t) && u != request.auth.uid
          && writable(get(tripPath(t)).data)
          && unlockCounted(t)
          && getAfter(personPath(t, resource.data.person)).data.uid == null;
      }

      match /expenses/{e} {
        allow read: if isMember(t) && alive(get(tripPath(t)).data);

        allow create: if isMember(t) && writable(get(tripPath(t)).data)
          && request.resource.data.keys().hasOnly(['type', 'amount', 'desc', 'cat', 'paidBy', 'split', 'by', 'ts', 'deleted'])
          && request.resource.data.keys().hasAll(['type', 'amount', 'desc', 'cat', 'paidBy', 'split', 'by', 'ts', 'deleted'])
          && validExpense(request.resource.data)
          && request.resource.data.by == myPerson(t)
          && request.resource.data.ts == request.time
          && request.resource.data.deleted == false;

        allow update: if isMember(t) && writable(get(tripPath(t)).data)
          && request.resource.data.keys().hasOnly(['type', 'amount', 'desc', 'cat', 'paidBy', 'split', 'by', 'ts', 'deleted', 'editedBy', 'editedAt'])
          && validExpense(request.resource.data)
          && request.resource.data.editedBy == myPerson(t)
          && request.resource.data.editedAt == request.time
          && (
            // The payer owns the expense: edits the content or deletes/restores it.
            (myPerson(t) == resource.data.paidBy
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['amount', 'desc', 'cat', 'split', 'deleted', 'editedBy', 'editedAt']))
            ||
            // The maker can only delete/restore.
            (isMaker(t)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['deleted', 'editedBy', 'editedAt']))
          );

        allow delete: if false;

        function validExpense(d) {
          return d.type in ['expense', 'settle']
            && (d.amount is int || d.amount is float) && d.amount > 0 && d.amount < 100000000
            && str(d.desc, 0, 60)
            && str(d.cat, 1, 20)
            && personId(d.paidBy)
            && exists(personPath(t, d.paidBy))
            && d.split is list && d.split.size() >= 1 && d.split.size() <= 20
            && d.split.hasOnly(['p1','p2','p3','p4','p5','p6','p7','p8','p9','p10',
                                'p11','p12','p13','p14','p15','p16','p17','p18','p19','p20'])
            && d.deleted is bool;
        }
      }
    }

    // Trips created per day (counter only; nobody reads it from the app).
    match /stats/{day} {
      allow read: if false;
      allow create: if signedIn() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
    }
  }
}
